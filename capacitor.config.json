{
  "appId": "com.pakscienceacademy.app",
  "appName": "Pak Science Academy",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://institute-management-backend-theta.vercel.app",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#12355A",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    }
  }
}
